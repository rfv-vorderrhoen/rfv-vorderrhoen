---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EventCalendarActions from "@/components/news/EventCalendarActions.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
import Section from "@/components/ui/Section.astro";
import { formatDate } from "@/lib/utils";

export async function getStaticPaths() {
    const entries = await getCollection("news", ({ data }) => !data.draft);
    return entries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const eventLocation = entry.data.location;
const eventLocationQuery = eventLocation ? encodeURIComponent(eventLocation) : "";
const eventMapsEmbedUrl = eventLocation
    ? `https://www.google.com/maps?q=${eventLocationQuery}&output=embed`
    : "";
---

<BaseLayout
    title={entry.data.seoTitle ?? `${entry.data.title} | RFV Vorderrhön`}
    description={entry.data.seoDescription ?? entry.data.description}
    image={entry.data.image?.src}
>
    <Section className="relative z-20 pb-0 pt-10 md:pt-16">
        {
            entry.data.isEvent ? (
                <div class="panel relative z-20 overflow-visible px-6 py-8 md:px-10 md:py-10">
                    <div
                        class:list={[
                            "grid gap-8",
                            eventLocation &&
                                "xl:grid-cols-[minmax(0,1fr)_minmax(20rem,0.78fr)] xl:items-stretch",
                        ]}
                    >
                        <div class="grid items-center">
                            <div class="relative z-10 min-w-0 max-w-3xl">
                                <div class="flex flex-wrap items-center gap-3">
                                    <span class="rounded-full border border-[rgba(47,71,50,0.12)] bg-white/82 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-[var(--color-forest)]">
                                        Veranstaltung
                                    </span>
                                    <p class="min-w-0 text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-moss)]">
                                        {formatDate(entry.data.date)}
                                    </p>
                                </div>
                                <h1 class="mt-5 text-4xl leading-tight md:text-6xl">
                                    {entry.data.title}
                                </h1>
                                <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--color-soft-ink)] md:text-xl">
                                    {entry.data.description}
                                </p>
                                <div class="mt-6">
                                    <EventCalendarActions entry={entry} />
                                </div>
                            </div>
                        </div>
                        {
                            eventLocation && (
                                <div class="relative z-10 min-h-[20rem] overflow-hidden rounded-[1.2rem] bg-white shadow-[0_18px_36px_rgba(24,31,25,0.1)] xl:min-h-full">
                                    <iframe
                                        src={eventMapsEmbedUrl}
                                        title={`Karte: ${entry.data.title}`}
                                        loading="lazy"
                                        referrerpolicy="strict-origin-when-cross-origin"
                                        allowfullscreen
                                        class="absolute inset-0 h-full w-full border-0 bg-white"
                                        style="filter: saturate(0.82) sepia(0.04) contrast(1.03);"
                                    />
                                </div>
                            )
                        }
                    </div>
                </div>
            ) : (
                <PageIntro
                    eyebrow={formatDate(entry.data.date)}
                    title={entry.data.title}
                    description={entry.data.description}
                />
            )
        }
    </Section>
    {
        entry.data.image && (
            <Section spaced={false} className="pb-8 pt-0 md:pb-10">
                <figure class="panel overflow-hidden">
                    <img
                        src={entry.data.image.src}
                        alt={entry.data.imageAlt ?? entry.data.title}
                        class="h-auto max-h-[38rem] w-full object-cover"
                    />
                </figure>
            </Section>
        )
    }
    <Section spaced={false} className="pt-0 pb-16">
        <article class="panel rich-text px-6 py-8 md:px-10 md:py-12">
            <Content />
        </article>
    </Section>
</BaseLayout>
